<script>
   
   let endTime = localStorage.getItem('countdownEndTimez');

    if (!endTime) {
        endTime = Date.now() + (24 * 60 * 60 * 1000);
        localStorage.setItem('countdownEndTimez', endTime);
    } else {
        endTime = parseInt(endTime);
    }
    
    const videos = [
        "https://setup.solario.ws/edance.mp4",
        "https://setup.solario.ws/itsfree.mp4",
        "https://setup.solario.ws/shirtspants.mp4"
    ];
    let currentVideo = 0;
    
    function playRandomVideo(){
        const video = document.getElementById("mangos-theory");
        video.src = videos[currentVideo];
        video.muted = false; 
        video.load();
        video.play().catch(e => {
            console.log("Video play error:", e);
           
            video.muted = true;
            video.play().catch(e => console.log("Muted video play error:", e));
        });
        currentVideo = (currentVideo + 1) % videos.length;
    }
    
    document.getElementById("blurredLines").addEventListener("click", function(){
        this.style.display = "none";
        playRandomVideo();
        showBadge();
        startHintInterval();
    });
    
    function showBadge(){
        const badge = document.getElementById("badgeNotification");
        badge.style.display = "flex";
        badge.style.right = "20px";
        setTimeout(() => {
            badge.style.right = "-300px";
        }, 5000);
    }
    
    function hideBadge(){
        document.getElementById("badgeNotification").style.right = "-300px";
    }
    
    function startHintInterval(){
        const messages = ["solario soon","solario soon.","solario soon..","solario soon..."];
        let messageIndex = 0;
        
        function changeHintMessage(){
            document.getElementById("hintMessage").innerText = messages[messageIndex];
            messageIndex = (messageIndex + 1) % messages.length;
        }
        
        changeHintMessage();
        setInterval(changeHintMessage, 408);
    }
    
    document.getElementById("badgeNotification").addEventListener("click", hideBadge);
    
    document.addEventListener("visibilitychange", function(){
        const video = document.getElementById("mangos-theory");
        if(document.visibilityState === "hidden"){
            video.pause();
        } else {
            video.play().catch(e => console.log("Visibility change play error:", e));
        }
    });
    
    document.getElementById("mangos-theory").addEventListener("ended", playRandomVideo);
    
    function updateCountdown() {
        const now = Date.now();
        const diff = endTime - now;
        
        if (diff <= 0) {
            localStorage.removeItem('countdownEndTimez');
            window.location.href = "/";
            return;
        }
        
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        
        document.getElementById("countdown-hours").textContent = hours.toString().padStart(2, '0');
        document.getElementById("countdown-minutes").textContent = minutes.toString().padStart(2, '0');
        document.getElementById("countdown-seconds").textContent = seconds.toString().padStart(2, '0');
        
        if (diff < 5 * 60 * 1000) {
            document.querySelectorAll('.countdown-box').forEach(box => {
                box.classList.add('pulse');
                box.style.background = 'rgba(255,50,50,0.7)';
            });
        }
    }
    updateCountdown();
    const countdownInterval = setInterval(updateCountdown, 1000);
    
    currentVideo = Math.floor(Math.random() * videos.length);
</script>
