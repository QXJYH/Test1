&#9;for i = 1,#guns do
&#9;&#9;if guns[i].Name == &quot;RocketLauncher&quot; and guns[i].className == &quot;Part&quot; then
&#9;&#9;&#9;local shoot = Instance.new(&quot;Part&quot;)
