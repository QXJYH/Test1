&#9;&#9;&#9;local rocket = script:findFirstChild(&quot;RocketScript&quot;):clone()
&#9;&#9;&#9;rocket.Disabled = false
&#9;&#9;&#9;rocket.Parent = shoot

&#9;&#9;&#9;shoot.Parent = Workspace
&#9;&#9;end
&#9;end
&#9;script.Parent:findFirstChild(&quot;Reload&quot;):play()
&#9;local swish = script.Parent:findFirstChild(&quot;FireRocket&quot;)
